# development | production
NODE_ENV=development

PORT=4000
# Use 0.0.0.0 on a server or in a container.
HOST=127.0.0.1

# SQLite database file. Must be on persistent storage in production.
# DB_PATH=./data/fams.db

# Demo mode: fills an empty database with sample faculty and enables the Reset Demo button.
# All sample accounts use DEMO_PASSWORD. Keep this off for real use.
DEMO_MODE=false
DEMO_PASSWORD=

# First HOD account, created only when the database is empty and DEMO_MODE is off.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_TTL_HOURS=168

# COOKIE_SECURE defaults to true when NODE_ENV=production, which requires HTTPS.
# COOKIE_SECURE=true
# Use "none" only when the frontend is on a different site from the API.
COOKIE_SAMESITE=lax

# Comma-separated frontend origins. Leave empty when the backend serves the frontend itself.
CORS_ORIGINS=

# Number of reverse proxies in front of the app (e.g. 1 for Nginx, Render or Railway).
# TRUST_PROXY=1
