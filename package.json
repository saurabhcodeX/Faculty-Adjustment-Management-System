{
  "name": "faculty-adjustment-system",
  "version": "1.0.0",
  "private": true,
  "description": "Faculty Adjustment Management System Desktop Application",
  "author": "FAMS Development Team",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "test": "npm test --prefix backend",
    "desktop:build": "npm run build --prefix frontend",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "productName": "Faculty Adjustment Management System",
    "directories": {
      "output": "desktop-release-clean"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!**/node_modules/**",
          "!**/.env",
          "!**/data/**",
          "!**/*.db",
          "!**/*.db-wal",
          "!**/*.db-shm"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "backend/data/fams-before-electron.db",
        "to": "initial-data/fams.db"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "normal"
  }
}
